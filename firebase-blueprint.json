{
  "entities": {
    "User": {
      "path": "users/{userId}",
      "fields": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "classId": { "type": "string" },
        "board": { "type": "string" },
        "stream": { "type": "string" },
        "selectedSubjects": { "type": "array" },
        "classSubjects": { "type": "map" },
        "avatarEmoji": { "type": "string" },
        "targetYear": { "type": "number" },
        "fcmToken": { "type": "string" },
        "notificationEnabled": { "type": "boolean" },
        "notificationClass": { "type": "string" },
        "fcmTokenUpdatedAt": { "type": "number" },
        "lastUpdated": { "type": "number" }
      }
    },
    "Progress": {
      "path": "users/{userId}/progress/summary",
      "fields": {
        "totalQuestionsSolved": { "type": "number" },
        "totalCorrect": { "type": "number" },
        "testsCompleted": { "type": "number" },
        "accuracy": { "type": "number" },
        "studyStreakDays": { "type": "number" },
        "lastStudyDate": { "type": "string" },
        "subjectStats": { "type": "map" },
        "recentHistory": { "type": "array" },
        "earnedBadges": { "type": "array" },
        "lastUpdated": { "type": "number" }
      }
    },
    "Announcement": {
      "path": "announcements/{announcementId}",
      "fields": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "classId": { "type": "string" },
        "type": { "type": "string" },
        "url": { "type": "string" },
        "createdAt": { "type": "number" }
      }
    },
    "SharedTest": {
      "path": "shared_tests/{testId}",
      "fields": {
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "classId": { "type": "string" },
        "totalQuestions": { "type": "number" },
        "timeLimitMinutes": { "type": "number" },
        "creatorUid": { "type": "string" },
        "creatorName": { "type": "string" },
        "creatorAvatar": { "type": "string" },
        "createdAt": { "type": "number" },
        "questions": { "type": "array" },
        "submissionCount": { "type": "number" }
      }
    },
    "TestSubmission": {
      "path": "shared_tests/{testId}/submissions/{submissionId}",
      "fields": {
        "testId": { "type": "string" },
        "userName": { "type": "string" },
        "isLoggedIn": { "type": "boolean" },
        "userId": { "type": "string" },
        "userAvatar": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "percentage": { "type": "number" },
        "timeTakenSeconds": { "type": "number" },
        "correctAnswers": { "type": "number" },
        "wrongAnswers": { "type": "number" },
        "submittedAt": { "type": "number" }
      }
    }
  },
  "rules": {
    "users": {
      "$userId": {
        "read": "auth != null && auth.uid == $userId",
        "write": "auth != null && auth.uid == $userId"
      }
    },
    "announcements": {
      "read": "true",
      "write": "auth != null"
    },
    "shared_tests": {
      "read": "true",
      "write": "auth != null",
      "submissions": {
        "read": "true",
        "write": "true"
      }
    }
  }
}
